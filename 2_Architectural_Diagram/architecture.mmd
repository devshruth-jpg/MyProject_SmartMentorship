flowchart TB
  subgraph PRES[Presentation Layer]
    SW[Student Web App]
    MW[Mentor Web App]
  end
  subgraph API[API Layer]
    GW[REST API Gateway + Auth JWT]
  end
  subgraph APP[Application Layer - modular monolith]
    AUTH[Auth & Profile]
    MATCH[Mentor Matching]
    AVAIL[Availability Manager]
    BOOK[Booking Engine]
    SCORE[Scorecard Service]
    NOTIF[Notification Scheduler]
    ADAPT[Integration Adapters]
  end
  subgraph DATA[Data Layer]
    PG[(PostgreSQL)]
    RD[(Redis cache + slot locks)]
    AUD[(Audit / Soft-delete)]
  end
  subgraph EXT[External Services]
    VC[Video Conferencing System]
    CAL[Calendar Provider]
    NS[Notification Service]
  end
  SW --> GW
  MW --> GW
  GW --> AUTH & MATCH & AVAIL & BOOK & SCORE
  BOOK --> NOTIF
  BOOK --> ADAPT
  AUTH & MATCH & AVAIL & BOOK & SCORE --> PG
  AVAIL & BOOK --> RD
  AUTH --> AUD
  ADAPT --> VC & CAL & NS
  NOTIF --> NS
